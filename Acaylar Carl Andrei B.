using System;
using System.IO;
using System.Text;

class Part07_SaveOrder Estrada/Acaylar
{
    static void Main()
    {
        string folderPath = "records";
        string filePath = Path.Combine(folderPath, "orders.txt");

        string orderId = "ORD0001";
        decimal total = 247.00m;
        decimal cash = 300.00m;
        decimal change = cash - total;

        string[] menuNames =
        {
            "Pork Chao Fan",
            "Beef Chao Fan"
        };

        decimal[] menuPrices = { 79.00m, 89.00m };
        int[] quantities = { 2, 1 };

        try
        {
            Directory.CreateDirectory(folderPath);

            StringBuilder record = new StringBuilder();

            record.Append(orderId);
            record.Append("|PAID");
            record.Append("|" + total.ToString("F2"));
            record.Append("|" + cash.ToString("F2"));
            record.Append("|" + change.ToString("F2"));

            int itemCount = 0;

            for (int i = 0; i < quantities.Length; i++)
            {
                if (quantities[i] > 0)
                    itemCount++;
            }

            record.Append("|" + itemCount);

            for (int i = 0; i < menuNames.Length; i++)
            {
                if (quantities[i] > 0)
                {
                    decimal subtotal = menuPrices[i] * quantities[i];

                    record.Append("|" + menuNames[i]);
                    record.Append("|" + menuPrices[i].ToString("F2"));
                    record.Append("|" + quantities[i]);
                    record.Append("|" + subtotal.ToString("F2"));
                }
            }

            File.AppendAllText(filePath, record.ToString() +
                Environment.NewLine);

            Console.WriteLine("Order saved successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Storage Error: " + ex.Message);
        }
    }
}
